# Copy this file to .env and fill it in. .env is gitignored - never commit real secrets.

# ---- Telegram (required for signal delivery) -------------------------------
# Bot token from @BotFather, chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LLM debate engine (all optional) --------------------------------------
# Cheapest path: install Claude Code, run `claude`, /login with your Claude
# plan. The app finds the CLI on PATH and uses your subscription - no API key.
# Otherwise drop an API key here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Force a provider instead of auto-detecting:
#   claude_code | anthropic | openai | deterministic
LLM_PROVIDER=

# Per-provider model overrides (sensible defaults are built in).
# CLAUDE_CLI_MODEL=haiku
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o-mini

# ---- App ---------------------------------------------------------------- --
BRAND=Dalal Desk
CONFIDENCE_THRESHOLD=7
AGENT_DELAY=0.7
SHORTLIST_PER_BUCKET=4
PORT=5000
